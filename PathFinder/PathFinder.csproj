<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType Condition="'$(TargetFramework)' == 'net48'">Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="C5" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Interfaces/IView.cs" />
    <Compile Remove="MainForm.cs" />
    <Compile Remove="MainForm.Designer.cs" />
    <Compile Remove="Presenter.cs" />
    <Compile Remove="Program.cs" />
    <Compile Remove="Properties/**" />
    <EmbeddedResource Remove="MainForm.resx" />
    <EmbeddedResource Remove="Properties/**" />
  </ItemGroup>
</Project>